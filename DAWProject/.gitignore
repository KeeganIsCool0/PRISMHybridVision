# Generated by Cargo (contains compiled files and executables)
/target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these to store debugging information
*.pdb

# Generated by cargo mutants (contains mutation testing data)
**/mutants.out/

# rustc will dump stack traces here when hitting an internal compiler error
rustc-ice-*.txt
